*.ipynb

# ── Benchmark data (too large for git) ───────────────────────────────────────
# The data lives in the benchmarks root ($TSAD_BENCHMARKS, default
# ~/Documents/tsad-benchmarks); these are local links into its tsb-ad/ folder.
# Only data/splits/ (small CSVs) is tracked.
data/raw
data/scores
data/metrics
data/runtime
data/notes.json
pyxida-data.zip

# ── Test / cache ──────────────────────────────────────────────────────────────
.pytest_cache/

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# ── Local only ────────────────────────────────────────────────────────────────
# Old work and notes, kept locally, not maintained
archive/

# The paper clone (its own git, Overleaf origin) and third-party PDFs
references/
# Local editor and agent settings
.claude/

# Derived tables (regenerable; divergence is ~4GB)
data/divergence/
data/anomaly_features_*.parquet

# Needle content packs and play logs (regenerable / private)
data/game/

# ── Web demo (web/) ───────────────────────────────────────────────────────────
# (web/.gitignore covers node_modules, .next, next-env.d.ts and .env files)
web/AGENTS.md

# Exported data for the web demo (regenerable with scripts/export_web.py)
data/web/
web/tests/scoring_golden.json
